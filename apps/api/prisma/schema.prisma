generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String     @id
  email     String     @unique
  password  String
  plans     Plan[]
  favorites Favorite[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Activity {
  id              String         @id
  title           String
  category        String
  area            String
  durationMinutes Int
  priceLevel      Int
  rating          Float
  imageUrl        String
  description     String
  tags            String[]
  planActivities  PlanActivity[]
  favorites       Favorite[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Favorite {
  userId     String
  activityId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)

  @@id([userId, activityId])
  @@index([activityId])
}

model Plan {
  id             String         @id
  userId         String
  name           String
  date           DateTime       @db.Date
  notes          String?
  user           User           @relation(fields: [userId], references: [id])
  planActivities PlanActivity[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId])
}

model PlanActivity {
  planId     String
  activityId String
  position   Int
  plan       Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)

  @@id([planId, activityId])
  @@index([activityId])
}
